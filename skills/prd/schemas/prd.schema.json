{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/prd-v2.schema.json",
  "title": "Product requirements document",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "revision", "title", "summary", "locale", "preDraft", "goals", "axes", "sources", "users", "userStories", "requirements", "designConsiderations", "successMetrics", "outOfScope", "openQuestions", "tasks"],
  "properties": {
    "$schema": {"type": "string", "minLength": 1},
    "schemaVersion": {"const": 2},
    "id": {"$ref": "#/$defs/id"},
    "revision": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "locale": {"enum": ["fr", "en"]},
    "preDraft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reuse", "sharedSurfaces", "sourcePriority"],
      "properties": {
        "reuse": {"$ref": "#/$defs/stringArray"},
        "sharedSurfaces": {"$ref": "#/$defs/stringArray"},
        "sourcePriority": {"$ref": "#/$defs/nonEmptyStringArray"}
      }
    },
    "goals": {"$ref": "#/$defs/stringArray"},
    "axes": {"type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": {"$ref": "#/$defs/axis"}},
    "sources": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/source"}},
    "users": {"$ref": "#/$defs/stringArray"},
    "userStories": {"$ref": "#/$defs/stringArray"},
    "requirements": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/requirement"}},
    "designConsiderations": {"$ref": "#/$defs/stringArray"},
    "successMetrics": {"$ref": "#/$defs/stringArray"},
    "outOfScope": {"$ref": "#/$defs/stringArray"},
    "openQuestions": {"$ref": "#/$defs/stringArray"},
    "tasks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/task"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$", "maxLength": 100},
    "axisId": {"type": "string", "pattern": "^A[1-9][0-9]*$"},
    "stringArray": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "nonEmptyStringArray": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "ref"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "ref": {"type": "string", "minLength": 1}
      }
    },
    "axis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "summary"],
      "properties": {
        "id": {"$ref": "#/$defs/axisId"},
        "title": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1}
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "axis", "kind", "title", "description", "priority", "status", "acceptance"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "axis": {"$ref": "#/$defs/axisId"},
        "kind": {"enum": ["functional", "non-functional"]},
        "title": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "priority": {"enum": ["must", "should", "could"]},
        "status": {"enum": ["proposed", "approved", "deferred"]},
        "acceptance": {"$ref": "#/$defs/nonEmptyStringArray"}
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "axis", "title", "expectedOutcome", "startCondition", "dependsOn", "acceptance", "boundaries"],
      "properties": {
        "id": {"type": "string", "pattern": "^T[1-9][0-9]*$"},
        "axis": {"$ref": "#/$defs/axisId"},
        "title": {"type": "string", "minLength": 1},
        "expectedOutcome": {"type": "string", "minLength": 1},
        "startCondition": {"type": "string", "minLength": 1},
        "dependsOn": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^T[1-9][0-9]*$"}},
        "acceptance": {"$ref": "#/$defs/nonEmptyStringArray"},
        "boundaries": {"$ref": "#/$defs/nonEmptyStringArray"}
      }
    }
  }
}
